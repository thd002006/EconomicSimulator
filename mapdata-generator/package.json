{
  "name": "economic-simulator-mapdata-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:world-modern": "tsx src/build-world-modern.ts",
    "generate:base": "tsx src/build-world-modern.ts --base",
    "generate:base:socioeconomic": "tsx src/socioeconomic/aggregate.ts --provinces base/world-admin1/geometry/provinces.geojson --out base/world-admin1/demographics.json --apply-gdp",
    "generate:countries": "tsx src/build-world-modern.ts --countries-only",
    "editor": "pnpm --dir editor dev",
    "export-map": "tsx src/export-map.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@turf/area": "7.4.0",
    "fflate": "0.8.2",
    "geotiff": "2.1.3",
    "polylabel": "2.1.0",
    "topojson-client": "3.1.0",
    "topojson-server": "3.0.1",
    "topojson-simplify": "3.0.3"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.2.0",
    "@types/polylabel": "2.0.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-server": "3.0.4",
    "@types/topojson-simplify": "3.0.3",
    "@types/topojson-specification": "1.0.5",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
